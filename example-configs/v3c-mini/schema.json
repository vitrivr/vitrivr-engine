{
  "schemas": {
    "v3cmini": {
      "connection": {
        "database": "PgVectorConnectionProvider",
        "parameters": {
          "host": "127.0.0.1",
          "port": "5432",
          "username": "vitrivr",
          "password": "vitrivr",
          "database": "vbs"
        }
      },
      "fields": {
        "file": {
          "factory": "FileSourceMetadata",
          "parameters": {"retrievableType": "SOURCE:VIDEO"}
        },
        "time": {
          "factory": "TemporalMetadata"
        },
        "clip": {
          "factory": "CLIP",
          "parameters": {
            "batchSize": "8",
            "host": "http://127.0.0.1:8888"
          }
        },
        "siglip2": {
          "factory": "SigLip2",
          "parameters": {
            "batchSize": "8",
            "host": "http://127.0.0.1:8888",
            "dimension": "768"
          }
        },
        "vlmcaption": {
          "factory": "VlmCaption",
          "parameters": {
            "enabled": "true",
            "baseUrl": "http://127.0.0.1:8000/v1",
            "model": "vitrivr-vlm",
            "promptVersion": "1",
            "maxOutputTokens": "128",
            "requestTimeoutMs": "60000",
            "maxConcurrentRequests": "4",
            "disableThinking": "true",
            "limit": "100"
          },
          "indexes": [
            {
              "attributes": [
                "caption"
              ],
              "type": "FULLTEXT",
              "parameters": {
                "language": "english",
                "gin": "true"
              }
            }
          ]
        },
        "ocr": {
          "factory": "OpticalCharacterRecognition",
          "parameters": {
            "concurrentRequests": "8",
            "host": "http://127.0.0.1:8888"
          },
          "indexes": [
            {
              "attributes": [
                "descriptor"
              ],
              "type": "FULLTEXT",
              "parameters": {
                "language": "english",
                "gin": "true"
              }
            }
          ]
        },
        "asr": {
          "factory": "AutomaticSpeechRecognition",
          "parameters": {
            "continuousVideo": "true",
            "host": "http://127.0.0.1:8888"
          },
          "indexes": [
            {
              "attributes": [
                "descriptor"
              ],
              "type": "FULLTEXT",
              "parameters": {
                "language": "english",
                "gin": "true"
              }
            }
          ]
        }
      },
      "resolvers": {
        "thumbnails": {
          "factory": "DiskResolver",
          "parameters": {"location": "./thumbnails"}
        }
      },
      "exporters": {
        "thumbnail": {
          "factory": "ThumbnailExporter",
          "parameters": {
            "resolver": "thumbnails",
            "maxSideResolution": "500",
            "mimeType": "JPG"
          }
        }
      },
      "extractionPipelines": {
        "mastershots": {
          "path": "video-ingest.json"
        }
      }
    }
  }
}
