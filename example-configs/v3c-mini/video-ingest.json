      "factory": "FileSystemEnumerator",
      "parameters": {
        "path": "/home/ubuntu/v3c_mini/v3c",
        "depth": "1",
        "mediaTypes": "VIDEO"
      }
    },
    "decode": {
      "factory": "MasterShotBoundaryDecoder",
