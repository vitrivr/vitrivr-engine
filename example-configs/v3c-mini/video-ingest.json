        "boundaryFilesPath": "/home/ubuntu/v3c_mini/msb_v3c",
        "boundaryFileExtension": ".tsv",
        "toNanoScale": "1e9",
        "videoSampleSize": "512",
        "decodeShotAudio": "false"
      }
    },
    "persist": {
      "factory": "PersistRetrievableTransformer"
    },
    "thumbnail": {
      "exporter": "thumbnail"
    },
    "file": {
      "field": "file"
    },
    "time": {
      "field": "time"
    },
    "clip": {
      "field": "clip"
    },
    "siglip2": {
      "field": "siglip2"
    },
    "vlmcaption": {
      "field": "vlmcaption"
    },
    "ocr": {
      "field": "ocr"
    },
    "asr": {
      "field": "asr"
    }
  },
  "operations": {
    "videos": {
      "operator": "videos"
    },
    "decode": {
