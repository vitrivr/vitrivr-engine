{
  "inputs": {
    "text": {
      "type": "TEXT",
      "data": "preparing food"
    }
  },
  "operations": {
    "scene": {
      "field": "clip",
      "inputs": {
        "text": "text"
      },
      "parameters": {
        "limit": "200",
        "filter.source": "Kitchen",
        "filter.source_type": "room"
      }
    },
    "unique": {
      "factory": "VisualDeduplicator",
      "inputs": {
        "in": "scene"
      },
      "parameters": {
        "field": "clip",
        "similarityThreshold": "0.98",
        "timeWindowSeconds": "60",
        "limit": "20"
      }
    },
    "relations": {
      "factory": "RelationExpander",
      "inputs": {
        "in": "unique"
      },
      "parameters": {
        "outgoing": "partOf"
      }
    },
    "timelookup": {
      "factory": "FieldLookup",
      "inputs": {
        "in": "relations"
      },
      "parameters": {
        "field": "time",
        "keys": "start, end"
      }
    },
    "filelookup": {
      "factory": "ObjectFieldLookup",
      "inputs": {
        "in": "timelookup"
      },
      "parameters": {
        "field": "file",
        "predicates": "partOf",
        "keys": "path"
      }
    }
  },
  "output": "filelookup"
}
