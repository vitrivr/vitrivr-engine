{
  "inputs": {
    "person1": {
      "type": "TEXT",
      "data": "Bob"
    },
    "person2": {
      "type": "TEXT",
      "data": "Anna"
    }
  },
  "operations": {
    "face1": {
      "field": "yoloadafacetwopass",
      "inputs": {
        "label": "person1"
      },
      "parameters": {
        "limit": "1000"
      }
    },
    "face2": {
      "field": "yoloadafacetwopass",
      "inputs": {
        "label": "person2"
      },
      "parameters": {
        "limit": "1000"
      }
    },
    "both": {
      "factory": "And",
      "inputs": {
        "first": "face1",
        "second": "face2"
      }
    },
    "relations": {
      "factory": "RelationExpander",
      "inputs": {
        "in": "both"
      },
      "parameters": {
        "outgoing": "partOf"
      }
    },
    "aggregator": {
      "factory": "ScoreAggregator",
      "inputs": {
        "in": "relations"
      }
    },
    "timelookup": {
      "factory": "FieldLookup",
      "inputs": {
        "in": "aggregator"
      },
      "parameters": {
        "field": "time",
        "keys": "start, end"
      }
    },
    "filelookup": {
      "factory": "ObjectFieldLookup",
      "inputs": {
        "in": "timelookup"
      },
      "parameters": {
        "field": "file",
        "predicates": "partOf",
        "keys": "path"
      }
    }
  },
  "output": "filelookup"
}
