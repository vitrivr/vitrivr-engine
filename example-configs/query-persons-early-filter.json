{
  "inputs": {
    "firstPerson": {
      "type": "TEXT",
      "data": "Werner"
    }
  },
  "operations": {
    "people": {
      "field": "yoloadafacetwopass",
      "inputs": {
        "label": "firstPerson"
      },
      "parameters": {
        "limit": "1000",
        "filter.persons": "Werner,Luca",
        "filter.personMode": "all",
        "filter.identityField": "yoloadafacetwopass"
      }
    },
    "relations": {
      "factory": "RelationExpander",
      "inputs": {
        "in": "people"
      },
      "parameters": {
        "outgoing": "partOf"
      }
    },
    "aggregator": {
      "factory": "ScoreAggregator",
      "inputs": {
        "in": "relations"
      }
    },
    "timelookup": {
      "factory": "FieldLookup",
      "inputs": {
        "in": "aggregator"
      },
      "parameters": {
        "field": "time",
        "keys": "start, end"
      }
    },
    "filelookup": {
      "factory": "ObjectFieldLookup",
      "inputs": {
        "in": "timelookup"
      },
      "parameters": {
        "field": "file",
        "predicates": "partOf",
        "keys": "path"
      }
    }
  },
  "output": "filelookup"
}
