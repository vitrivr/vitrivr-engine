{
  "schemas": {
    "sandbox": {
      "connection": {
        "database": "PgVectorConnectionProvider",
        "parameters": {
          "host": "10.34.64.127",
          "port": "5432",
          "username": "postgres",
          "password": "vitrivr"
        }
      },
      "fields": {
        "averagecolor": {
          "factory": "AverageColor"
        },
        "file": {
          "factory": "FileSourceMetadata"
        },
        "clip": {
          "factory": "CLIP",
          "parameters": {
            "host": "http://localhost:8888"
          }
        },
        "dino": {
          "factory": "DINO",
          "parameters": {
            "host": "http://localhost:8888"
          }
        },
        "ocr": {
          "factory": "OpticalCharacterRecognition",
          "parameters": {
            "host": "http://localhost:8888"
          }
        },
        "asr": {
          "factory": "AutomaticSpeechRecognition",
          "parameters": {
            "host": "http://localhost:8888"
          }
        },
        "time": {
          "factory": "TemporalMetadata"
        },
        "video": {
          "factory": "VideoSourceMetadata"
        }
      },
      "resolvers": {
        "thumbnails": {
          "factory": "DiskResolver",
          "parameters": {
            "location": "/path/to/thumbnails"
          }
        }
      },
      "exporters": {
        "thumbnail": {
          "factory": "ThumbnailExporter",
          "parameters": {
            "resolver": "thumbnails",
            "maxSideResolution": "500",
            "mimeType": "JPG"
          }
        }
      },
      "extractionPipelines": {
        "vid": {
          "path": "./example-configs/video-ingest.json"
        }
      }
    }
  }
}
